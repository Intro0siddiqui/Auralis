{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auralis",
  "version": "2.1.21",
  "identifier": "com.auralis.v2",
  "build": {
    "frontendDist": "ui",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Auralis",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: https: data: blob: ipc: http://ipc.localhost; img-src 'self' data: blob: asset: https://i.ytimg.com https://*.ytimg.com; media-src 'self' data: blob: asset: ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https:; font-src 'self' data: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "app", "dmg", "msi", "nsis"],
                "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Music",
    "shortDescription": "Lightweight offline-first music player",
    "longDescription": "Auralis is a privacy-focused music player with integrated media downloading and P2P synchronization. Built on Rust + Tauri for tiny binaries under 50MB.",
    "publisher": "Auralis Team",
    "copyright": "Copyright \u00a9 2026 Auralis Team",
    "homepage": "https://github.com/Intro0siddiqui/Auralis",
    "resources": [
      "ui/partials/*"
    ],
    "externalBin": [],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
